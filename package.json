{
  "name": "hub-grade-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'),path=require('path');const walk=d=>{if(!fs.existsSync(d))return;for(const f of fs.readdirSync(d)){const p=path.join(d,f);const s=fs.statSync(p);if(s.isDirectory())walk(p);else if(p.endsWith('.map'))fs.rmSync(p)}};walk('dist')\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --test --experimental-strip-types tests/study-data-model.test.ts tests/transcript-import-model.test.ts tests/delete-account-otp.test.ts tests/schedule-board-model.test.ts tests/cloudflare-announcements-model.test.ts",
    "cf:d1:migrate:local": "node scripts/run-wrangler.mjs d1 migrations apply hub-planner-public-dev --local --config cloudflare/wrangler.jsonc",
    "cf:d1:migrate:remote": "node scripts/run-wrangler.mjs d1 migrations apply hub-planner-public-dev --remote --config cloudflare/wrangler.jsonc",
    "cf:d1:seed:local": "node scripts/seed-school-announcements-d1.mjs",
    "cf:d1:seed:remote": "node scripts/seed-school-announcements-d1.mjs --remote",
    "cf:dev": "node scripts/run-wrangler.mjs dev --local --config cloudflare/wrangler.jsonc",
    "cf:check": "node scripts/run-wrangler.mjs deploy --dry-run --config cloudflare/wrangler.jsonc",
    "cf:deploy:dev": "node scripts/run-wrangler.mjs deploy --config cloudflare/wrangler.jsonc",
    "cf:test:shadow:local": "node scripts/compare-school-announcements-backends.mjs",
    "cf:test:shadow:remote": "node scripts/compare-school-announcements-backends.mjs --candidate=https://hub-planner-public-dev-api.tqhoangg2.workers.dev",
    "ocr:notifications": "node scripts/ocr_need_review_notifications.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@axiomhq/winston": "^1.4.0",
    "@fontsource/inter": "^5.2.8",
    "@google/genai": "^1.34.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@supabase/supabase-js": "^2.97.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.5",
    "dotenv": "^17.3.1",
    "groq-sdk": "^0.37.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "5.0.7",
    "lucide-react": "^0.562.0",
    "papaparse": "5.4.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.21.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-particles": "^2.12.2",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0",
    "sweetalert2": "^11.26.24",
    "tsparticles-slim": "^2.12.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.115.0"
  }
}
