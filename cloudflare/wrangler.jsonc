{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hub-planner-public-dev-api",
  "workers_dev": true,
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/internal/profile/*",
      "/internal/profile-shadow/*",
      "/internal/schedules/*",
      "/internal/courses/*",
      "/__account-delete-synthetic-test",
      "/__account-delete-synthetic-test/turnstile-frame",
      "/__managed-auditors",
      "/health",
      "/events",
      "/courses",
      "/lost-found"
    ]
  },
  "routes": [
    {
      "pattern": "hotrosinhvienhub.id.vn/*",
      "zone_name": "hotrosinhvienhub.id.vn"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173,https://hotrosinhvienhub.id.vn,https://hub-planner-public-dev-api.tqhoangg2.workers.dev",
    "EVENT_CANDIDATE_EXTENSION_ORIGINS": "chrome-extension://bakbfjmgpjcmpicoehjadpakiogjikaa",
    "SUPABASE_URL": "https://udrlnbmctcxtmxrncmsb.supabase.co",
    "AUTH_SERVICE_PROXY_ENABLED": "true",
    "MANAGED_AUDITOR_TURNSTILE_SITE_KEY": "0x4AAAAAAEK-7MF6_cD_DkJr",
    "SCHEDULE_WRITE_MODE": "d1",
    "SCHEDULE_D1_INTERNAL_ENABLED": "true",
    "COURSE_WRITE_AUTHORITY": "d1",
    "COURSE_READ_AUTHORITY": "d1",
    "COURSE_D1_INTERNAL_ENABLED": "true",
    "COURSE_SCRAPER_INTERNAL_ENABLED": "false",
    "HK1_SCRAPER_ENABLED": "true",
    "COURSE_SCRAPER_MANUAL_ENABLED": "true",
    "COURSE_SCRAPER_CRON_ENABLED": "false",
    "NOTIFICATION_JOBS_ENABLED": "true",
    "NOTIFICATION_JOBS_MODE": "enabled",
    "NOTIFICATION_REENABLE_CUTOFF": "2026-08-31T11:23:39Z",
    "EVENT_PUSH_CUTOFF": "2026-09-09T14:30:00Z",
    "SCHEDULE_PUSH_CUTOFF": "2026-09-16T00:00:00Z",
    "COURSE_SUPABASE_TO_D1_SYNC_ENABLED": "false",
    "PROFILE_READ_AUTHORITY": "d1",
    "PROFILE_WRITE_AUTHORITY": "d1",
    "PROFILE_D1_SHADOW_READ_ENABLED": "true",
    "PROFILE_D1_SHADOW_WRITE_ENABLED": "true",
    "PROFILE_D1_SHADOW_WRITE_PERCENT": "100",
    "PROFILE_D1_SHADOW_INTERNAL_ENABLED": "true"
  },
  "triggers": {
    "crons": ["*/15 * * * *", "7 * * * *", "37 19 * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "PUSH_EVENTS_QUEUE",
        "queue": "hub-planner-push-events"
      }
    ],
    "consumers": [
      {
        "queue": "hub-planner-push-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "hub-planner-push-events-dlq",
        "max_concurrency": 2
      }
    ]
  },
  "workflows": [
    {
      "name": "hub-planner-hk1-course-scraper",
      "binding": "HK1_SCRAPER_WORKFLOW",
      "class_name": "HK1CourseScraperWorkflow"
    },
    {
      "name": "hub-planner-hk1-course-scraper-probe",
      "binding": "HK1_SCRAPER_PROBE_WORKFLOW",
      "class_name": "HK1CourseScraperProbeWorkflow"
    },
    {
      "name": "hub-planner-school-announcement-crawler",
      "binding": "ANNOUNCEMENT_CRAWLER_WORKFLOW",
      "class_name": "AnnouncementCrawlerWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hub-planner-public-dev",
      "database_id": "88d702e1-60d3-490a-8514-38ef881cf133",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUPPORT_ATTACHMENTS_BUCKET",
      "bucket_name": "hub-planner"
    },
    {
      "binding": "AI_DOCUMENTS_BUCKET",
      "bucket_name": "hub-planner"
    }
  ],
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "hub-planner-auth-production"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_INGRESS_IP_RATE_LIMIT",
      "namespace_id": "45871911",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
