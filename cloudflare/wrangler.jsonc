{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hub-planner-public-dev-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-29",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173,https://hotrosinhvienhub.id.vn",
    "SUPABASE_URL": "https://udrlnbmctcxtmxrncmsb.supabase.co"
  },
  "triggers": {
    "crons": ["17 * * * *", "*/10 * * * *", "*/5 * * * *", "37 19 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hub-planner-public-dev",
      "database_id": "88d702e1-60d3-490a-8514-38ef881cf133",
      "migrations_dir": "migrations"
    }
  ]
}
